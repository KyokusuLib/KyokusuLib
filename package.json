{
  "name": "kyokusulib",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run backend & bun run frontend & bun run ranobehub & bun run tg-bot",
    "backend": "cd backend && go run ./cmd/api/main.go",
    "frontend": "cd frontend && bun run dev",
    "ranobehub": "cd apps/ranobehub-parser && bun run index",
    "tg-bot": "cd apps/kyokusu-tg-bot && bun run start",
    "cli-build": "cd cli && go build -o ../kyokusu-cli",
    "cli": "bun run cli-build && ./kyokusu-cli",
    "backup": "bun run cli-build && ./kyokusu-cli dmp postgres -env ./backend/.env",
    "kill": "bun run cli-build && ./kyokusu-cli kill -p 8080"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
